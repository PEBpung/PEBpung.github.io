---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Sidebar from "@/components/Sidebar.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="mx-auto w-full max-w-5xl px-4">
    <div class="grid gap-6 py-6 lg:gap-12 lg:py-12 lg:grid-cols-[260px_1fr]">
      <!-- Sidebar -->
      <div class="border-b border-border pb-6 lg:sticky lg:top-12 lg:self-start lg:border-b-0 lg:pb-0">
        <Sidebar posts={posts} />
      </div>

      <!-- Posts -->
      <div class="pt-2">
        {
          featuredPosts.length > 0 && (
            <section
              id="featured"
              class:list={[
                "pb-6",
                { "border-b border-border": recentPosts.length > 0 },
              ]}
            >
              <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
              <ul>
                {featuredPosts.map(data => (
                  <Card variant="h3" {...data} />
                ))}
              </ul>
            </section>
          )
        }

        {
          recentPosts.length > 0 && (
            <section id="recent-posts" class:list={["pb-6", { "pt-8": featuredPosts.length > 0 }]}>
              <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
              <ul>
                {recentPosts.map(
                  (data, index) =>
                    index < SITE.postPerIndex && <Card variant="h3" {...data} />
                )}
              </ul>
            </section>
          )
        }

        <div class="my-8 text-center">
          <LinkButton href="/posts/">
            All Posts
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  function updateIndexBackUrl() {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  }

  if (!window.__indexBackUrlBound) {
    document.addEventListener("astro:page-load", updateIndexBackUrl);
    window.__indexBackUrlBound = true;
  }

  updateIndexBackUrl();
</script>
