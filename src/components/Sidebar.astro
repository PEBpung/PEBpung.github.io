---
import type { CollectionEntry } from "astro:content";
import { PROFILE, SITE } from "@/config";
import { SOCIALS } from "@/constants";
import LinkButton from "./LinkButton.astro";
import getUniqueTags from "@/utils/getUniqueTags";

type Props = {
  posts: CollectionEntry<"blog">[];
};

const { posts } = Astro.props;
const tags = getUniqueTags(posts);
---

<!-- Vertical centered layout on all viewports -->
<aside class="flex flex-col items-center text-center">
  <img
    src={PROFILE.image}
    alt={PROFILE.username}
    class="mb-4 size-28 rounded-full object-cover ring-4 ring-accent/20 lg:size-36"
  />
  <h1 class="text-xl font-bold lg:text-2xl">{SITE.title}</h1>
  <p class="mt-1 text-sm text-foreground/60">@{PROFILE.username}</p>
  <p class="mt-2 text-sm leading-relaxed text-foreground/80">{PROFILE.description}</p>

  {
    SOCIALS.length > 0 && (
      <div class="mt-4 flex gap-2 lg:mt-5">
        {SOCIALS.map(social => (
          <LinkButton
            href={social.href}
            class="rounded-full bg-muted p-2.5 transition-colors hover:bg-accent/20 hover:rotate-6"
            title={social.linkTitle}
          >
            <social.icon class="inline-block size-5 fill-transparent stroke-current stroke-2 opacity-80" />
            <span class="sr-only">{social.linkTitle}</span>
          </LinkButton>
        ))}
      </div>
    )
  }
</aside>

<!-- Tags -->
<div class="mt-5 flex flex-wrap justify-center gap-2.5 lg:mt-8">
  {
    tags.slice(0, 8).map(({ tag, tagName }) => (
      <a
        href={`/tags/${tag}/`}
        class="rounded-full bg-accent/10 px-3 py-1 text-xs font-medium text-accent transition-colors hover:bg-accent/25"
      >
        #{tagName}
      </a>
    ))
  }
</div>
