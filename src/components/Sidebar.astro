---
import { getCollection } from "astro:content";
import { PROFILE, SITE } from "@/config";
import { SOCIALS } from "@/constants";
import LinkButton from "./LinkButton.astro";
import getUniqueTags from "@/utils/getUniqueTags";

const posts = await getCollection("blog");
const tags = getUniqueTags(posts);
---

<!-- Mobile: compact horizontal layout / Desktop: vertical sidebar -->
<aside class="flex items-center gap-4 text-left lg:flex-col lg:items-center lg:text-center">
  <img
    src={PROFILE.image}
    alt={PROFILE.username}
    class="size-20 shrink-0 rounded-full object-cover ring-4 ring-accent/20 lg:size-36"
  />
  <div class="min-w-0 lg:contents">
    <h1 class="text-lg font-bold lg:mt-4 lg:text-2xl">{SITE.title}</h1>
    <p class="text-xs text-foreground/60 lg:mt-1 lg:text-sm">@{PROFILE.username}</p>
    <p class="mt-1 text-xs leading-relaxed text-foreground/80 lg:mt-3 lg:text-sm">{PROFILE.description}</p>

    {
      SOCIALS.length > 0 && (
        <div class="mt-2 flex gap-2 lg:mt-5">
          {SOCIALS.map(social => (
            <LinkButton
              href={social.href}
              class="rounded-full bg-muted p-2 transition-colors hover:bg-accent/20 hover:rotate-6 lg:p-2.5"
              title={social.linkTitle}
            >
              <social.icon class="inline-block size-4 fill-transparent stroke-current stroke-2 opacity-80 lg:size-5" />
              <span class="sr-only">{social.linkTitle}</span>
            </LinkButton>
          ))}
        </div>
      )
    }
  </div>
</aside>

<!-- Tags: horizontal scroll on mobile, wrap on desktop -->
<div class="mt-4 flex gap-2 overflow-x-auto pb-1 lg:mt-8 lg:flex-wrap lg:justify-center lg:gap-2.5 lg:overflow-visible lg:pb-0">
  {
    tags.slice(0, 8).map(({ tag, tagName }) => (
      <a
        href={`/tags/${tag}/`}
        class="shrink-0 rounded-full bg-accent/10 px-3 py-1 text-xs font-medium text-accent transition-colors hover:bg-accent/25"
      >
        #{tagName}
      </a>
    ))
  }
</div>
